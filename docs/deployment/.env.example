# ============================================================================
# Finance Bigdata Platform — Environment Variables
# ============================================================================
# Copy this file to .env and update values before running docker compose.
#   cp docs/deployment/.env.example .env
# ============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=credit_platform
MYSQL_USER=credit_admin
MYSQL_PASSWORD=credit_pass_2024

# --- Redis ---
REDIS_PASSWORD=redis_pass_2024

# --- Security ---
# JWT signing key — MUST be changed in production
AUTH_SECRET_KEY=change-me-in-production

# --- Elasticsearch ---
# No credentials needed (xpack.security.enabled=false in dev)

# --- Model Platform ---
MODEL_PLATFORM_HOST=0.0.0.0
MODEL_PLATFORM_PORT=8082
MODEL_PLATFORM_DEBUG=false
MODEL_PLATFORM_DB_URL=mysql+pymysql://credit_admin:credit_pass_2024@mysql:3306/model_platform?charset=utf8mb4
MODEL_PLATFORM_REDIS_URL=redis://:redis_pass_2024@redis:6379/2

# --- Docker Resource Limits (optional) ---
# JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8
