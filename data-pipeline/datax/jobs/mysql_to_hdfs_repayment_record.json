{
    "job": {
        "content": [
            {
                "reader": {
                    "name": "mysqlreader",
                    "parameter": {
                        "username": "etl_user",
                        "password": "etl_password_123",
                        "connection": [
                            {
                                "jdbcUrl": ["jdbc:mysql://mysql:3306/credit_platform?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai"],
                                "querySql": ["SELECT id, loan_id, customer_id, installment_no, due_date, repay_date, repay_amount, principal, interest, overdue_days, status, source_system, etl_time FROM repayment_record WHERE DATE(etl_time) = '${dt}'"]
                            }
                        ],
                        "column": [
                            "id",
                            "loan_id",
                            "customer_id",
                            "installment_no",
                            "due_date",
                            "repay_date",
                            "repay_amount",
                            "principal",
                            "interest",
                            "overdue_days",
                            "status",
                            "source_system",
                            "etl_time"
                        ],
                        "where": ""
                    }
                },
                "writer": {
                    "name": "hdfswriter",
                    "parameter": {
                        "defaultFS": "hdfs://namenode:9000",
                        "fileType": "orc",
                        "path": "/data/ods/ods_repayment_record/dt=${dt}",
                        "fileName": "ods_repayment_record",
                        "column": [
                            {"name": "id", "type": "BIGINT"},
                            {"name": "loan_id", "type": "STRING"},
                            {"name": "customer_id", "type": "STRING"},
                            {"name": "installment_no", "type": "INT"},
                            {"name": "due_date", "type": "DATE"},
                            {"name": "repay_date", "type": "DATE"},
                            {"name": "repay_amount", "type": "DOUBLE"},
                            {"name": "principal", "type": "DOUBLE"},
                            {"name": "interest", "type": "DOUBLE"},
                            {"name": "overdue_days", "type": "INT"},
                            {"name": "status", "type": "STRING"},
                            {"name": "source_system", "type": "STRING"},
                            {"name": "etl_time", "type": "TIMESTAMP"}
                        ],
                        "writeMode": "truncate",
                        "fieldDelimiter": "",
                        "compress": "SNAPPY",
                        "encoding": "UTF-8"
                    }
                }
            }
        ],
        "setting": {
            "speed": {
                "channel": 3
            },
            "errorLimit": {
                "record": 0,
                "percentage": 0.02
            }
        }
    }
}
